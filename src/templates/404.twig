{% extends 'layout.twig' %}
{% block main %}
    <section class="page-intro" aria-labelledby="page-title">
      <div class="wrap">
        <h1 id="page-title">Page not found</h1>
        <p class="lede">There’s no page at this address. It may have moved, or the address may have a typing mistake.</p>
        <ul class="plain-list">
          <li><a href="/">Go to the SightPress home page</a></li>
          <li><a href="/features/">See what SightPress can do</a></li>
          <li><a href="/blog/">Read the blog</a></li>
          <li><a href="/faq/">Read the frequently asked questions</a></li>
        </ul>
        <p>If a link on this website brought you here, please <a href="mailto:{{ site.email }}?subject=Broken%20link%20on%20sightpress.org">tell us about the broken link</a>.</p>
      </div>
    </section>
{% endblock %}
