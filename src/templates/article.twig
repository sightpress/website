{% extends 'layout.twig' %}
{% import 'partials/macros.twig' as m %}
{% set article = page.article %}
{% block main %}
    <article class="article" aria-labelledby="article-title">
      <header class="article-header">
        <div class="wrap">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <ol>
              <li><a href="/">Home</a></li>
              <li><a href="/articles/">Articles</a></li>
              <li><a href="/articles/section/{{ article.section|slug }}/">{{ article.section }}</a></li>
            </ol>
          </nav>
          <h1 id="article-title">{{ article.title }}</h1>
          <p class="article-byline">By <a href="/about/#creator">Pedro Ferreira</a></p>
          <dl class="article-facts">
            <div><dt>Published</dt><dd><time datetime="{{ article.published }}">{{ article.published|long_date }}</time></dd></div>
{% if article.updated %}
            <div><dt>Updated</dt><dd><time datetime="{{ article.updated }}">{{ article.updated|long_date }}</time></dd></div>
{% endif %}
            <div><dt>Reading time</dt><dd>{{ article.readingMinutes }} {{ article.readingMinutes == 1 ? 'minute' : 'minutes' }}</dd></div>
            <div><dt>Section</dt><dd><a href="/articles/section/{{ article.section|slug }}/">{{ article.section }}</a></dd></div>
          </dl>
{% if article.tags is not empty %}
          <h2 class="visually-hidden" id="tags-title">Topics</h2>
          <ul class="tag-list">
{% for tag in article.tags %}
            <li><a href="/articles/tag/{{ tag }}/">{{ tag|tag_label }}</a></li>
{% endfor %}
          </ul>
{% endif %}
        </div>
      </header>

      <div class="wrap">
        <div class="prose">
{{ article.html|raw }}
        </div>
      </div>
    </article>

    <section class="section section-alt" aria-labelledby="share-title">
      <div class="wrap">
        <h2 id="share-title">Share this article</h2>
        {% include 'partials/share.twig' with {share_url: page.url, share_text: article.title, share_subject: article.title} %}
{% if article.copies is not empty %}
        <h3>Where else to read this</h3>
        <ul class="plain-list">
{% for copy in article.copies %}
          <li><a href="{{ copy }}">{{ article.title }} on {{ copy|split('/')[2]|replace({'www.': ''}) }}</a></li>
{% endfor %}
        </ul>
{% endif %}
        <p>This article is also available <a href="{{ page.markdown }}">as Markdown</a>.</p>
      </div>
    </section>

{% if page.newer or page.older %}
    <nav class="section pager" aria-label="More articles">
      <div class="wrap split">
{% if page.older %}
        <p><span class="pager-label">Previous article</span> <a href="{{ page.older.path }}">{{ page.older.title }}</a></p>
{% endif %}
{% if page.newer %}
        <p><span class="pager-label">Next article</span> <a href="{{ page.newer.path }}">{{ page.newer.title }}</a></p>
{% endif %}
      </div>
    </nav>
{% endif %}

{% if page.related is not empty %}
    <section class="section section-alt" aria-labelledby="related-title">
      <div class="wrap">
        <h2 id="related-title">Related articles</h2>
        <ul class="article-list">
{% for related in page.related %}
          {{ m.article_item(related, 3) }}
{% endfor %}
        </ul>
      </div>
    </section>
{% endif %}

    <section class="section" aria-labelledby="cta-title">
      <div class="wrap">
        <div class="contact-box">
          <h2 id="cta-title">Follow SightPress</h2>
          <p>SightPress is in early development. Hear when it’s ready for live websites, or see what works today.</p>
          <div class="actions">
            {% include 'partials/stay-informed.twig' %}
            <a class="button button-secondary" href="/features/">See the features</a>
          </div>
        </div>
      </div>
    </section>
{% endblock %}
