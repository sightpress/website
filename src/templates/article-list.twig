{% extends 'layout.twig' %}
{% import 'partials/macros.twig' as m %}
{% block main %}
    <section class="page-intro" aria-labelledby="page-title">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><a href="/articles/">Articles</a></li>
          </ol>
        </nav>
        <p class="eyebrow">{{ page.kind == 'section' ? 'Section' : 'Topic' }}</p>
        <h1 id="page-title">{{ page.heading }}</h1>
        <p class="lede">{{ page.articles|length }} {{ page.articles|length == 1 ? 'article' : 'articles' }}, newest first.</p>
      </div>
    </section>

    <section class="section" aria-labelledby="list-title">
      <div class="wrap">
        <h2 id="list-title" class="visually-hidden">Articles</h2>
        <ul class="article-list">
{% for article in page.articles %}
          {{ m.article_item(article, 3) }}
{% endfor %}
        </ul>
        <p><a href="/articles/">All articles</a></p>
      </div>
    </section>
{% endblock %}
