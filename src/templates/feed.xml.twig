<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en-GB">
  <id>{{ site.url }}/articles/feed.xml</id>
  <title>SightPress articles</title>
  <subtitle>Release notes, the story behind SightPress, and what we learn about accessible publishing.</subtitle>
  <link rel="self" type="application/atom+xml" href="{{ site.url }}/articles/feed.xml"/>
  <link rel="alternate" type="text/html" href="{{ site.url }}/articles/"/>
  <updated>{{ updated }}T00:00:00Z</updated>
  <author>
    <name>{{ site.author }}</name>
    <uri>{{ site.url }}/about/#creator</uri>
  </author>
  <icon>{{ site.url }}/brand/favicons/icon-192.png</icon>
  <rights>© SightPress</rights>
{% for article in articles %}
  <entry>
    <id>{{ site.url }}{{ article.path }}</id>
    <title>{{ article.title }}</title>
    <link rel="alternate" type="text/html" href="{{ site.url }}{{ article.path }}"/>
    <published>{{ article.published }}T00:00:00Z</published>
    <updated>{{ article.lastModified }}T00:00:00Z</updated>
    <summary>{{ article.description }}</summary>
    <category term="{{ article.section|slug }}" label="{{ article.section }}"/>
{% for tag in article.tags %}
    <category term="{{ tag }}" label="{{ tag|tag_label }}"/>
{% endfor %}
    <content type="html">{{ contents[loop.index0] }}</content>
  </entry>
{% endfor %}
</feed>
