<!doctype html>
<html lang="en-GB" dir="ltr" data-color-scheme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.fullTitle }}</title>
  <meta name="description" content="{{ page.description }}">
  <meta name="robots" content="{{ page.robots }}">
  <meta name="author" content="{{ site.author }}">
{% if page.robots != 'noindex' %}
  <link rel="canonical" href="{{ page.url }}">
{% endif %}
  <meta name="theme-color" content="#101430">
  <meta property="og:type" content="{{ page.type }}">
  <meta property="og:site_name" content="SightPress">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta property="og:title" content="{{ page.socialTitle ?? page.title }}">
  <meta property="og:description" content="{{ page.description }}">
  <meta property="og:url" content="{{ page.url }}">
  <meta property="og:image" content="{{ page.image.path|absolute }}">
  <meta property="og:image:type" content="image/png">
  <meta property="og:image:width" content="{{ page.image.width }}">
  <meta property="og:image:height" content="{{ page.image.height }}">
  <meta property="og:image:alt" content="{{ page.image.alt }}">
{% if page.type == 'article' %}
  <meta property="article:published_time" content="{{ page.article.published }}">
  <meta property="article:modified_time" content="{{ page.article.lastModified }}">
  <meta property="article:author" content="{{ site.url }}/about/#creator">
  <meta property="article:section" content="{{ page.article.section }}">
{% for tag in page.article.tags %}
  <meta property="article:tag" content="{{ tag|tag_label }}">
{% endfor %}
{% endif %}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page.socialTitle ?? page.title }}">
  <meta name="twitter:description" content="{{ page.description }}">
  <meta name="twitter:image" content="{{ page.image.path|absolute }}">
  <meta name="twitter:image:alt" content="{{ page.image.alt }}">
  <link rel="preload" href="/brand/fonts/atkinson-hyperlegible-next-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/brand/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/brand/fonts/fonts.css">
  <link rel="stylesheet" href="/brand/tokens/tokens.css">
  <link rel="stylesheet" href="/assets/site.css">
  <script src="/assets/theme.js"></script>
  <link rel="icon" href="/brand/favicons/favicon.ico" sizes="48x48">
  <link rel="icon" href="/brand/favicons/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/brand/favicons/apple-touch-icon.png">
  <link rel="manifest" href="/brand/favicons/site.webmanifest">
  <link rel="alternate" type="application/atom+xml" href="/articles/feed.xml" title="SightPress articles">
{% if page.markdown %}
  <link rel="alternate" type="text/markdown" href="{{ page.markdown }}" title="This article in Markdown">
{% endif %}
{% if page.jsonLd %}
  <script type="application/ld+json">
{{ page.jsonLd|raw }}
  </script>
{% endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  <header class="site-header">
    <div class="wrap header-bar">
      <a class="brand" href="/">
        <img class="logo-light" src="/brand/logo/sightpress-logo.svg" width="168" height="35" alt="SightPress home">
        <img class="logo-dark" src="/brand/logo/sightpress-logo-dark.svg" width="168" height="35" alt="SightPress home">
      </a>
      <div class="header-tools">
        <button type="button" class="theme-toggle" id="theme-toggle" hidden data-label-light="Switch to light theme" data-label-dark="Switch to dark theme">Switch to light theme</button>
        <nav aria-label="Main">
          <ul class="nav-list">
{% for item in [
  {key: 'home', href: '/', label: 'Home'},
  {key: 'about', href: '/about/', label: 'About'},
  {key: 'features', href: '/features/', label: 'Features'},
  {key: 'articles', href: '/articles/', label: 'Articles'},
] %}
{% set exact = page.nav == item.key and page.path == item.href %}
            <li><a href="{{ item.href }}"{% if exact %} aria-current="page"{% elseif page.nav == item.key %} aria-current="true"{% endif %}>{{ item.label }}</a></li>
{% endfor %}
          </ul>
        </nav>
      </div>
    </div>
    <div class="prelaunch">
      <p class="wrap"><svg class="icon" aria-hidden="true" focusable="false"><use href="/brand/icons/sprite.svg#sp-icon-info"/></svg><span><strong>SightPress is in early development.</strong> Test releases are available for developers; it is not ready for live sites yet. <a href="/features/#try">How to try a test release</a></span></p>
    </div>
  </header>

  <main id="main">
{% block main %}{% endblock %}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <p class="footer-motto"><strong>SightPress</strong>. Beyond sight<span class="dot">.</span></p>
        <p>{{ site.tagline }} Open source under GPL-3.0-or-later.</p>
        <p>Latest test release: <a href="{{ site.release.notes }}">{{ site.release.version }}, {{ site.release.date|long_date }}</a>.</p>
      </div>
      <nav aria-label="Footer">
        <h2 class="footer-heading">Explore</h2>
        <ul class="footer-links">
          <li><a href="/about/">About</a></li>
          <li><a href="/features/">Features</a></li>
          <li><a href="/articles/">Articles</a></li>
          <li><a href="/articles/feed.xml">Articles feed (Atom)</a></li>
          <li><a href="{{ site.docs }}">Documentation</a></li>
          <li><a href="{{ site.github }}">SightPress on GitHub</a></li>
          <li><a href="{{ site.community.conduct }}">Code of Conduct</a></li>
          <li><a href="/#contact">Contact</a></li>
          <li><a href="/accessibility/">Accessibility statement</a></li>
        </ul>
      </nav>
      <div>
        <h2 class="footer-heading">About this site</h2>
        <p>We aim to meet WCAG 2.2 AA. This site works without JavaScript, and it has no cookies, trackers or third-party scripts. If something is hard to use, please <a href="mailto:{{ site.email }}?subject=Website%20accessibility%20feedback">tell us about it by email</a>.</p>
      </div>
    </div>
  </footer>
</body>
</html>
