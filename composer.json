{
    "name": "sightpress/website",
    "description": "The sightpress.org website: a small static site built from Twig templates and Markdown articles.",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": "^8.4",
        "league/commonmark": "^2.7",
        "symfony/yaml": "^7.3",
        "twig/twig": "^3.21"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "SightPress\\Website\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "build": "bin/build",
        "phpstan": "phpstan analyse --no-progress",
        "check": [
            "@phpstan",
            "bin/build --check"
        ]
    }
}
